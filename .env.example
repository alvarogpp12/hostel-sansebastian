# Copia este archivo a .env.local y rellena los valores.
# .env.local NO se sube al repositorio.

# ── Dominio público (canonical, sitemap, datos estructurados) ──────────────
NEXT_PUBLIC_SITE_URL=https://www.enjoycomfortsansebastian.com

# Indexación en Google. Dejar SIN definir (o en false) mientras la web tenga
# datos de relleno. Poner a true solo cuando la dirección, el teléfono, el NIF
# y los precios sean los reales.
SITE_INDEXABLE=false
