# Copia este archivo a .env.local y rellena los valores.
# .env.local NO se sube al repositorio.

# ── Dominio público (canonical, sitemap, datos estructurados) ──────────────
NEXT_PUBLIC_SITE_URL=https://www.enjoycomfortsansebastian.com

# ── Stripe ────────────────────────────────────────────────────────────────
# Panel de Stripe > Desarrolladores > Claves de API.
# Usa las claves de PRUEBA (sk_test_...) hasta que todo esté verificado.
STRIPE_SECRET_KEY=sk_test_xxx

# Firma del webhook. En local se obtiene con:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# En producción, al crear el endpoint en Stripe > Desarrolladores > Webhooks
# apuntando a https://TU-DOMINIO/api/stripe/webhook
# Eventos necesarios: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Beds24 (pendiente: hace falta la cuenta) ──────────────────────────────
# Token de la API v2. Se genera en Beds24: SETTINGS > MARKETPLACE > API,
# creando un "invite code" y canjeándolo por un refresh token.
# BEDS24_REFRESH_TOKEN=
