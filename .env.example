# Copia este archivo a .env.local y rellena los valores.
# .env.local NO se sube al repositorio.

# ── Dominio público (canonical, sitemap, datos estructurados) ──────────────
NEXT_PUBLIC_SITE_URL=https://enjoycomfort.com

# Indexación en Google: permitida solo en producción (VERCEL_ENV=production).
# false = bloquearla también en producción.
# SITE_INDEXABLE=false

# Pantalla de "Próximamente": la web está abierta. false = volver a mostrarla
# en producción. En local y en las vistas previas nunca se ve.
# SITE_LAUNCHED=false

# ── Reservas ──────────────────────────────────────────────────────────────
# Créalas en .env.local y en Vercel (Production y Preview). Ver docs/redforts.md.
#   legacy   = motor de Redforts en un iframe (por defecto)
#   redforts = reserva nativa con la Booking API v5 + pago con Stripe
BOOKING_PROVIDER=legacy

# ── Redforts (Booking API v5) ─────────────────────────────────────────────
REDFORTS_API_BASE=https://booking.redforts.com/api
# Código de conexión: SECRETO. Va dentro de la URL de la API; nunca al
# repositorio ni a una variable NEXT_PUBLIC_.
REDFORTS_CONNECTION_CODE=
# Email que recibe las notificaciones de las reservas de prueba
REDFORTS_TEST_EMAIL=
# true = todas las reservas se mandan con api_test (Redforts NO las crea en
# el PMS). true en local y Preview; false en Production solo cuando se decida.
REDFORTS_TEST_MODE=true

# ── Stripe ────────────────────────────────────────────────────────────────
# Claves de PRUEBA (sk_test_...) hasta que todo esté verificado.
STRIPE_SECRET_KEY=
# Firma del webhook. En local: stripe listen --forward-to localhost:3000/api/stripe/webhook
# En Vercel: endpoint https://TU-DOMINIO/api/stripe/webhook con los eventos
# checkout.session.completed y checkout.session.expired.
STRIPE_WEBHOOK_SECRET=

# ── Supabase (registro de reservas e idempotencia del webhook) ────────────
# Project Settings > API. La clave secreta (sb_secret_… o service_role) solo
# se usa en el servidor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
